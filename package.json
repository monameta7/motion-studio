{
  "name": "mahdiyar-motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local app that turns a topic into a finished, branded, voice-over motion-graphics reel for Mahdiyar Hoosh Afza.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit && tsc -p app/ui --noEmit",
    "test": "vitest run",
    "job": "tsx app/cli.ts",
    "revise": "tsx app/revise.ts",
    "start": "tsx app/server.ts",
    "ui:build": "vite build --config app/ui/vite.config.ts",
    "ui:dev": "vite --config app/ui/vite.config.ts",
    "lib:add": "tsx app/library/addCli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "node-notifier": "^12.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
